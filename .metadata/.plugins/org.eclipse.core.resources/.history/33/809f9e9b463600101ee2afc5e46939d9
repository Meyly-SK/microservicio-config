package com.example.microservicio_producto.service;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import com.example.commons.service.CommonServiceImpl;
import com.example.microservicio_producto.clients.CategoriaFeignClient;
import com.example.microservicio_producto.clients.ProveedorFeignClient;
import com.example.microservicio_producto.models.Categoria;
import com.example.microservicio_producto.models.Producto;
import com.example.microservicio_producto.models.ProveedorDTO;
import com.example.microservicio_producto.repository.ProductoRepository;

@Service
public class ProductoServiceImpl extends CommonServiceImpl<Producto, ProductoRepository> implements ProductoService {

	@Autowired
	private CategoriaFeignClient client;
	
	@Autowired
	private ProveedorFeignClient clientProveedor;
	@Override
	public List<Producto> obtenerProductosPorCategoria(Long categoriaId) {
		// TODO Auto-generated method stub
		return repository.findByCategoriaId(categoriaId);
	}

	@Override
	public Iterable<Categoria> obtenerCategorias() {
		// TODO Auto-generated method stub
		return client.obtenerCategorias();
	}

	@Override
	public Categoria obtenerCategoriaPorId(Long categoriaId) {
	    try {
	        Categoria categoriaDTO = client.obtenerCategoriaPorId(categoriaId);
	        if (categoriaDTO == null) {
	            throw new RuntimeException("Categoría no encontrada");
	        }
	        return categoriaDTO;
	    } catch (Exception e) {
	        throw new RuntimeException("Error al obtener la categoría: " + e.getMessage());
	    }
	}
	
	@Override
	public List<Producto> obtenerProductosPorProveedor(Long proveedorId) {
		// TODO Auto-generated method stub
		return repository.findByProveedorId(proveedorId);
	}
	
	@Override
	public ProveedorDTO obtenerProveedoraPorId(Long proveedorId) {
		// TODO Auto-generated method stub
		try {
	        ProveedorDTO proveedorDTO = clientProveedor.obtenerProveedorPorId(proveedorId);
	        if (proveedorDTO == null) {
	            throw new RuntimeException("Proveedor no encontrado");
	        }
	        return proveedorDTO;
	    } catch (Exception e) {
	        throw new RuntimeException("Error al obtener el Proveedor: " + e.getMessage());
	    }
	}
	

}
