package com.example.microservicio_movimiento.service;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import com.example.commons.service.CommonServiceImpl;
import com.example.microservicio_movimiento.clients.ProductoFeignClient;
import com.example.microservicio_movimiento.models.MovimientoInventario;
import com.example.microservicio_movimiento.models.Producto;
import com.example.microservicio_movimiento.repository.MovimientoInventarioRepository;

@Service
public class MovimientoInventarioServiceImpl extends CommonServiceImpl<MovimientoInventario, MovimientoInventarioRepository> implements MovimientoInventarioService{

	@Autowired
	private ProductoFeignClient client; 
	
	
	@Override
	public Producto guardarProducto(Producto producto) {
		// TODO Auto-generated method stub
		return client.guardarProducto(producto);
	}

	@Override
	public Producto obtenerProductoPorId(Long id) {
		// TODO Auto-generated method stub
		return client.obtenerProductoPorId(id);
	}


}
