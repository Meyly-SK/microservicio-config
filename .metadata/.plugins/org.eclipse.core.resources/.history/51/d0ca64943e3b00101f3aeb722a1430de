package com.example.microservicio.proveedor.controller;

import java.util.Optional;

import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.validation.BindingResult;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.PutMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RestController;

import com.example.commons.controller.CommonController;
import com.example.microservicio.proveedor.model.Proveedor;
import com.example.microservicio.proveedor.service.ProveedorService;

import jakarta.ws.rs.NotFoundException;

@RestController
public class ProveedorController extends CommonController<Proveedor, ProveedorService>{

	@PostMapping("/{id}")
	public ResponseEntity<?> editar(@RequestBody Proveedor proveedor, BindingResult result , @PathVariable Long id){
		
		if(result.hasErrors()) {
			return this.validar(result);
		}
		
		Proveedor dbProveedor = this.service.findById(id)
				.orElseThrow(() -> new NotFoundException("Proveedor con ID " + id + " no encontrada"));
		
		dbProveedor.setNombre(proveedor.getNombre());
		dbProveedor.setTelefono(proveedor.getTelefono());
		dbProveedor.setDireccion(proveedor.getDireccion());
		dbProveedor.setEmail(proveedor.getEmail());
		return ResponseEntity.status(HttpStatus.CREATED).body(this.service.save(dbProveedor));
	}
}
