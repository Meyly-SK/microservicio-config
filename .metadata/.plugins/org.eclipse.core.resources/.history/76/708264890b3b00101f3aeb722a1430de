package com.example.webflux;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.CommandLineRunner;
import org.springframework.boot.SpringApplication;
import org.springframework.boot.autoconfigure.SpringBootApplication;

import com.example.webflux.documents.Producto;
import com.example.webflux.repository.ProductoRepository;
import com.sun.org.slf4j.internal.LoggerFactory;

import reactor.core.publisher.Flux;

@SpringBootApplication
public class WebfluxApplication implements CommandLineRunner{

	@Autowired
	private ProductoRepository dao;
	
	
	public static void main(String[] args) {
		SpringApplication.run(WebfluxApplication.class, args);
	}

	@Override
	public void run(String... args) throws Exception {
		// TODO Auto-generated method stub
		Flux.just(new Producto("TV Panasonic Pantalla LCD", 456.89),
				  new Producto("Sony Notebook", 846.89))
		.flatMap(producto -> dao.save(producto) )
		.subscribe(producto -> System.out.println("Insert: " + producto ));
	}

}
